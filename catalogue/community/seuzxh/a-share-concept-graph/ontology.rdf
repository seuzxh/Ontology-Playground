<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/a/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/a/">

    <owl:Ontology rdf:about="http://example.org/ontology/a/">
        <rdfs:label>A股概念图谱</rdfs:label>
        <rdfs:comment>股票、行业、概念板块、财务指标与公告的自定义本体示例（量化研究场景）</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== -->
    <!-- Entity Types (Classes) -->
    <!-- ===================== -->

    <owl:Class rdf:about="http://example.org/ontology/a/Stock">
        <rdfs:label>Stock</rdfs:label>
        <rdfs:comment>一只在交易所上市交易的股票</rdfs:comment>
        <ont:icon>📈</ont:icon>
        <ont:color>#0078D4</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/a/Industry">
        <rdfs:label>Industry</rdfs:label>
        <rdfs:comment>行业分类节点（申万一级/二级/三级）</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#107C10</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/a/Concept">
        <rdfs:label>Concept</rdfs:label>
        <rdfs:comment>主题概念板块，如低空经济、AI算力</rdfs:comment>
        <ont:icon>💡</ont:icon>
        <ont:color>#5C2D91</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/a/Indicator">
        <rdfs:label>Indicator</rdfs:label>
        <rdfs:comment>定期报告披露的财务指标</rdfs:comment>
        <ont:icon>🧮</ont:icon>
        <ont:color>#FFB900</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/a/Announcement">
        <rdfs:label>Announcement</rdfs:label>
        <rdfs:comment>上市公司公告事件</rdfs:comment>
        <ont:icon>📢</ont:icon>
        <ont:color>#D83B01</ont:color>
    </owl:Class>

    <!-- ================ -->
    <!-- Data Properties -->
    <!-- ================ -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/stock_code">
        <rdfs:label>code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>股票代码，如 600519</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/stock_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>证券简称</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/stock_listDate">
        <rdfs:label>listDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>上市日期</rdfs:comment>
        <ont:propertyType>date</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/stock_marketCap">
        <rdfs:label>marketCap</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>总市值</rdfs:comment>
        <ont:unit>CNY</ont:unit>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/stock_peRatio">
        <rdfs:label>peRatio</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>市盈率</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/industry_industryId">
        <rdfs:label>industryId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Industry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>行业代码</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/industry_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Industry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>行业名称</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/industry_level">
        <rdfs:label>level</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Industry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>分类层级（1/2/3）</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/concept_conceptId">
        <rdfs:label>conceptId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>概念代码</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/concept_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>概念名称</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/concept_heat">
        <rdfs:label>heat</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>热度分</rdfs:comment>
        <ont:propertyType>integer</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/concept_source">
        <rdfs:label>source</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Concept"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>来源（同花顺/东财/自定义）</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/indicator_indicatorId">
        <rdfs:label>indicatorId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>指标ID</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/indicator_name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>指标名称，如 ROE、营收增速</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/indicator_value">
        <rdfs:label>value</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>指标值</rdfs:comment>
        <ont:propertyType>decimal</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/indicator_reportDate">
        <rdfs:label>reportDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Indicator"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>报告期</rdfs:comment>
        <ont:propertyType>date</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/announcement_announcementId">
        <rdfs:label>announcementId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Announcement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>公告ID</rdfs:comment>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/announcement_title">
        <rdfs:label>title</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Announcement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>公告标题</rdfs:comment>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/announcement_publishDate">
        <rdfs:label>publishDate</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Announcement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>发布时间</rdfs:comment>
        <ont:propertyType>datetime</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/a/announcement_type">
        <rdfs:label>type</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Announcement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>公告类型</rdfs:comment>
        <ont:enumValues>财报,重大事项,风险提示,其他</ont:enumValues>
        <ont:propertyType>enum</ont:propertyType>
    </owl:DatatypeProperty>

    <!-- ================== -->
    <!-- Object Properties -->
    <!-- ================== -->

    <owl:ObjectProperty rdf:about="http://example.org/ontology/a/stock_belongs_to_industry">
        <rdfs:label>belongs to</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://example.org/ontology/a/Industry"/>
        <rdfs:comment>每只股票归属一个一级行业</rdfs:comment>
        <ont:cardinality>many-to-one</ont:cardinality>
        <ont:fromEntityId>stock</ont:fromEntityId>
        <ont:toEntityId>industry</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/a/concept_includes_stock">
        <rdfs:label>includes</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Concept"/>
        <rdfs:range rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:comment>概念板块与成分股多对多</rdfs:comment>
        <ont:cardinality>many-to-many</ont:cardinality>
        <ont:fromEntityId>concept</ont:fromEntityId>
        <ont:toEntityId>stock</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/a/stock_discloses_indicator">
        <rdfs:label>discloses</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://example.org/ontology/a/Indicator"/>
        <rdfs:comment>股票按报告期披露财务指标</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>stock</ont:fromEntityId>
        <ont:toEntityId>indicator</ont:toEntityId>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/ontology/a/stock_publishes_announcement">
        <rdfs:label>publishes</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/a/Stock"/>
        <rdfs:range rdf:resource="http://example.org/ontology/a/Announcement"/>
        <rdfs:comment>股票发布公告</rdfs:comment>
        <ont:cardinality>one-to-many</ont:cardinality>
        <ont:fromEntityId>stock</ont:fromEntityId>
        <ont:toEntityId>announcement</ont:toEntityId>
    </owl:ObjectProperty>

</rdf:RDF>
